{
  "schema_version": "0.1",
  "case_id": "wiseword-amlmonth-001",
  "title": "多類型騾子戶口 — 一個月警報（示範劇本）",
  "locale": "zh-Hant",
  "summary": "合成培訓案例。同一零售戶口在一個覆核窗內收到兼職薪金、網戀贈與、賭博退回與購物退款，付款人都不是已知對手。學員不得用單一故事結案，快進快出時亦不得再等解釋。靈感來自警方公開的多類型騾子網絡簡述，不是真實客戶檔。",
  "start_node_id": "n_bundle",
  "teaching": {
    "level": "chan-1-scripted-mirror",
    "rules_before_ai": true,
    "case_kind": "public_record_inspired",
    "disclaimer": "Synthetic training scenario inspired by public enforcement reporting. Not official case files; no real customer data.",
    "themes": ["mule account", "job scam", "romance scam", "shopping scam", "gambling"],
    "sources": [
      {
        "label": "Police press, August 2023 WISEWORD (URL not in the course brief)"
      }
    ],
    "acceptable_dispositions": ["str_drafted", "freeze_recommended", "edd_hold"],
    "poor_dispositions": ["false_positive_cleared"]
  },
  "rules": [
    {
      "id": "R1_MULTI_TYPOLOGY",
      "when": "同一覆核窗內至少兩類詐騙入帳打進同一戶口",
      "then": "require_edd_or_str",
      "note": "不得用客戶的單一故事結案。規則先於任何模型分數。"
    },
    {
      "id": "R2_FAST_OUT",
      "when": "入帳後短時間內要求現金提取或轉走接近全額",
      "then": "require_freeze_or_str",
      "note": "不得等候客戶再解釋工作。覆寫必須留在事件軌上。"
    }
  ],
  "initial_twin_state": {
    "phase": "alert_triage",
    "customer": {
      "id": "SYN-WW-314",
      "display_name": "合成客戶丙",
      "segment": "retail"
    },
    "kyc": {
      "status": "basic_cdd_on_file",
      "signals": ["multi_typology_credits"]
    },
    "account": {
      "id": "SYN-ACC-WW-314",
      "opened": true,
      "holds": []
    },
    "transactions": [],
    "risk": {
      "score": 45,
      "flags": []
    },
    "disposition": null
  },
  "nodes": [
    {
      "id": "n_bundle",
      "type": "scene",
      "title": "一個月內的多類入帳",
      "prompt": "合成客戶丙的戶口在一個月內收到四類入帳：網上兼職薪金、網戀贈與、賭博充值退回、購物退款。付款人都不是已知對手。",
      "next": "n_frame",
      "twin_patch": {
        "transactions": [
          {
            "id": "TX-WW-1",
            "kind": "job_style_credit",
            "amount": 48000
          },
          {
            "id": "TX-WW-2",
            "kind": "romance_style_credit",
            "amount": 70000
          },
          {
            "id": "TX-WW-3",
            "kind": "gambling_style_credit",
            "amount": 36000
          },
          {
            "id": "TX-WW-4",
            "kind": "shopping_style_credit",
            "amount": 22000
          }
        ],
        "risk.flags_add": ["MULTI_TYPOLOGY"]
      }
    },
    {
      "id": "n_frame",
      "type": "decision",
      "title": "把警報看成一件還是四件",
      "prompt": "四類入帳在同一戶口。你要當成一個網絡調查、先聽客戶一種說法，還是分成互不相干的雜訊？",
      "choices": [
        {
          "id": "one_network",
          "label": "當成同一戶口上的一組類型",
          "next": "n_story",
          "rationale": "先對類型，再讓 R1 判斷能否用一個故事結案。",
          "effects": {
            "risk.flags_add": ["NETWORK_VIEW"]
          }
        },
        {
          "id": "one_story_ask",
          "label": "只問客戶一種解釋",
          "next": "n_story",
          "rationale": "可以問，但一種說法覆蓋不了其餘付款人。",
          "effects": {
            "kyc.status": "explanation_requested"
          }
        },
        {
          "id": "unrelated_noise",
          "label": "分成四宗雜訊並放行",
          "next": "n_dispersal",
          "rationale": "教學上的較差起點。類型數量仍在，快進快出會觸發 R2。",
          "effects": {
            "risk.flags_add": ["TYPOLOGY_SPLIT"],
            "risk.score_delta": 25
          }
        }
      ]
    },
    {
      "id": "n_story",
      "type": "scene",
      "title": "客戶只有兼職一個故事",
      "prompt": "客戶只說是網上兼職，說不出其餘付款人是誰。規則 R1：兩類或以上入帳不得用單一故事結案。",
      "next": "n_r1_gate",
      "twin_patch": {
        "kyc.status": "single_story",
        "risk.flags_add": ["STORY_DOES_NOT_COVER"]
      }
    },
    {
      "id": "n_r1_gate",
      "type": "decision",
      "title": "單一故事是否夠用",
      "prompt": "R1 已滿足。暫停出帳做加強審查、現在草擬可疑交易報告，還是接受兼職說法？",
      "choices": [
        {
          "id": "edd_hold",
          "label": "暫停出帳並做加強審查",
          "next": "n_dispersal",
          "rationale": "符合 R1。出帳先停，再看會不會快進快出。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["EDD_HOLD"]
          }
        },
        {
          "id": "draft_str",
          "label": "草擬可疑交易報告",
          "next": "n_outcome_str",
          "rationale": "多類型入帳已足夠上報。",
          "effects": {
            "risk.flags_add": ["STR_DRAFTED"]
          }
        },
        {
          "id": "accept_job",
          "label": "接受兼職說法並放行",
          "next": "n_dispersal",
          "rationale": "覆寫 R1。其餘三類入帳沒有被解釋掉。",
          "effects": {
            "risk.flags_add": ["R1_OVERRIDDEN"],
            "risk.score_delta": 30
          }
        }
      ]
    },
    {
      "id": "n_dispersal",
      "type": "scene",
      "title": "要求即日轉走",
      "prompt": "客戶要求即日現金提取及轉帳，金額接近入帳合計。規則 R2：快進快出不得再等下一個工作故事。",
      "next": "n_r2_gate",
      "twin_patch": {
        "phase": "alert_triage",
        "risk.flags_add": ["FAST_OUT"]
      }
    },
    {
      "id": "n_r2_gate",
      "type": "decision",
      "title": "快進快出怎麼停",
      "prompt": "R2 已滿足。建議凍結並上報、維持加強審查暫停，或放行？",
      "choices": [
        {
          "id": "freeze_str",
          "label": "建議凍結並草擬可疑交易報告",
          "next": "n_outcome_freeze",
          "rationale": "符合 R2。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["STR_DRAFTED", "FREEZE_RECOMMENDED"]
          }
        },
        {
          "id": "keep_edd",
          "label": "維持暫停並完成加強審查",
          "next": "n_outcome_edd",
          "rationale": "符合 R2 的另一出口。戶口先停，再補證據。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["EDD_HOLD"]
          }
        },
        {
          "id": "release",
          "label": "放行並結案",
          "next": "n_outcome_miss",
          "rationale": "教學上的較差路徑。規則已要求不得這樣結案。",
          "effects": {
            "account.holds": [],
            "risk.flags_add": ["R2_IGNORED"]
          }
        }
      ]
    },
    {
      "id": "n_outcome_str",
      "type": "outcome",
      "title": "已草擬可疑交易報告",
      "prompt": "上報出口。四類入帳都留在交易清單，沒有被兼職故事蓋掉。",
      "terminal": true,
      "twin_patch": {
        "phase": "closed",
        "disposition": "str_drafted"
      }
    },
    {
      "id": "n_outcome_freeze",
      "type": "outcome",
      "title": "已建議凍結並草擬報告",
      "prompt": "出帳停住，報告已草擬。若先前把類型拆開或覆寫過 R1，那些旗標仍在。",
      "terminal": true,
      "twin_patch": {
        "phase": "closed",
        "disposition": "freeze_recommended"
      }
    },
    {
      "id": "n_outcome_edd",
      "type": "outcome",
      "title": "加強審查並暫停出帳",
      "prompt": "戶口仍開，出帳暫停，等待加強審查補齊付款人。",
      "terminal": true,
      "twin_patch": {
        "phase": "closed",
        "disposition": "edd_hold"
      }
    },
    {
      "id": "n_outcome_miss",
      "type": "outcome",
      "title": "放行結案",
      "prompt": "較差路徑。R2 被忽略。儀表板之後應把這次 session 標成未跟規則。",
      "terminal": true,
      "twin_patch": {
        "phase": "closed",
        "disposition": "false_positive_cleared"
      }
    }
  ]
}
