        {
          "id": "accept_help",
          "label": "接受幫忙投資並放行",
          "next": "n_proceeds",
          "rationale": "覆寫 R1。覆寫是事件，群組編號仍留在狀態。",
          "effects": {
            "risk.flags_add": ["R1_OVERRIDDEN"],
            "risk.score_delta": 35
          }
        }
      ]
