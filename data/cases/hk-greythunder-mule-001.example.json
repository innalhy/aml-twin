      "choices": [
        {
          "id": "edd_cluster",
          "label": "對群組做加強審查",
          "next": "n_story",
          "rationale": "先聽說法，但群組事實不會因一句話消失。",
          "effects": {
            "kyc.status": "edd_ordered",
            "risk.flags_add": ["EDD_ORDERED"]
          }
        },
        {
          "id": "restrict",
          "label": "先限制出帳",
          "next": "n_story",
          "rationale": "限制與約談可以同時做。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["EDD_HOLD"]
          }
        },
        {
          "id": "release_friend",
          "label": "接受朋友說法並放行",
          "next": "n_proceeds",
          "rationale": "教學覆寫。群組連線仍在，後續得益會觸發 R2。",
          "effects": {
            "risk.flags_add": ["CLUSTER_WAIVED"],
