    {
      "id": "n_r1_gate",
      "type": "decision",
      "title": "要不要覆寫群組規則",
      "prompt": "R1 已滿足。維持限制、現在草擬可疑交易報告，還是接受幫忙投資？",
      "choices": [
        {
          "id": "hold",
          "label": "維持限制並繼續審查",
          "next": "n_proceeds",
          "rationale": "符合 R1。先看資金是不是隨即彙集轉出。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["EDD_HOLD"]
