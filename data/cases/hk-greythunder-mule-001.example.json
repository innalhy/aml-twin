    {
      "id": "n_proceeds",
      "type": "scene",
      "title": "入帳隨即彙集轉出",
      "prompt": "入帳備註與假冒機構、投資話術一致，款項隨即彙集轉出。規則 R2：不得用朋友的投資把這宗結案。",
      "next": "n_r2_gate",
      "twin_patch": {
        "phase": "alert_triage",
        "transactions": [
          {
            "id": "TX-GT-1",
            "kind": "fake_official_style_in",
            "amount_hkd": 150000
          },
          {
            "id": "TX-GT-2",
            "kind": "investment_style_in",
            "amount_hkd": 210000
          },
          {
            "id": "TX-GT-3",
            "kind": "consolidation_out",
            "amount_hkd": 340000
          }
