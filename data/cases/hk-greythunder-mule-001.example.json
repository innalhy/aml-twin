  "title": "騾子群組 — 假冒機構與投資得益（示範劇本）",
  "locale": "zh-Hant",
  "summary": "合成培訓案例。零售戶口與一個合成群組共用收款戶口及登入裝置。客戶稱在幫朋友處理官方退款與投資本金，但不認識付款人。學員要先按群組規則加強審查，再決定上報、凍結或退出。靈感來自公開的騾子群組簡述，不是真實客戶檔。",
  "start_node_id": "n_link",
  "teaching": {
    "level": "chan-1-scripted-mirror",
    "rules_before_ai": true,
    "case_kind": "public_record_inspired",
    "disclaimer": "Synthetic training scenario inspired by public enforcement reporting. Not official case files; no real customer data.",
    "themes": ["mule cluster", "fake official", "investment fraud proceeds", "shared device"],
    "sources": [
      {
        "label": "HK enforcement briefing, GREYTHUNDER (May–November 2022 activity; URL not in the course brief)"
      }
    ],
    "acceptable_dispositions": ["str_drafted", "freeze_recommended", "account_exit"],
    "poor_dispositions": ["false_positive_cleared"]
