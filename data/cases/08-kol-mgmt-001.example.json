      "type": "decision",
      "title": "混合得益怎麼記",
      "prompt": "R2 已滿足。建議凍結並上報、退出關係，或維持品牌合作記帳？",
      "choices": [
        {
          "id": "str_freeze",
          "label": "建議凍結並草擬可疑交易報告",
          "next": "n_outcome_freeze",
          "rationale": "符合 R2。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["STR_DRAFTED", "FREEZE_RECOMMENDED"]
          }
        },
        {
          "id": "exit_rel",
          "label": "退出客戶關係",
          "next": "n_outcome_exit",
          "rationale": "符合 R2 的退出出口。",
          "effects": {
            "risk.flags_add": ["RELATIONSHIP_EXIT"]
          }
        },
        {
          "id": "clear_brand",
          "label": "維持品牌合作並結案",
          "next": "n_outcome_miss",
          "rationale": "教學上的較差路徑。規則已要求不得這樣結案。",
          "effects": {
            "risk.flags_add": ["R2_IGNORED"]
          }
        }
      ]
