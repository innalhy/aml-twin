    {
      "id": "n_outcome_miss",
      "type": "outcome",
      "title": "當成品牌合作結案",
      "prompt": "較差路徑。R2 被忽略。儀表板之後應把這次 session 標成未跟規則。",
      "terminal": true,
      "twin_patch": {
        "phase": "closed",
        "disposition": "false_positive_cleared"
