{
  "schema_version": "0.1",
  "case_id": "hk-kol-mgmt-001",
  "title": "網紅管理公司 — 前台戶口（示範劇本）",
  "locale": "zh-Hant",
  "summary": "合成培訓案例。一間聲稱經營網紅管理的公司沒有品牌合約，戶口卻收到像購物、投資、網戀話術的個人入帳，並快速轉出。關聯的另一間合成公司流水相似。學員決定加強審查、草擬可疑交易報告、建議凍結或退出，不得把入帳記成品牌合作。靈感來自公開的網紅管理公司前台簡述，不是真實客戶檔。",
  "start_node_id": "n_profile",
  "teaching": {
    "level": "chan-1-scripted-mirror",
    "rules_before_ai": true,
    "case_kind": "public_record_inspired",
    "disclaimer": "Synthetic training scenario inspired by public enforcement reporting. Not official case files; no real customer data.",
    "themes": ["KOL management front", "third-party retail credits", "phone fraud", "investment fraud", "romance fraud"],
    "sources": [
      {
        "label": "HK enforcement briefing on KOL management company accounts (URL not in the course brief)"
      }
    ],
    "acceptable_dispositions": ["str_drafted", "freeze_recommended", "account_exit"],
    "poor_dispositions": ["false_positive_cleared"]
  },
  "rules": [
    {
      "id": "R1_FRONT_COMPANY",
      "when": "聲稱的網紅管理業務沒有合約或員工紀錄，且入帳來自零售第三者",
      "then": "require_edd_or_exit",
      "flags": ["NO_BUSINESS_RECORD", "R1_OVERRIDDEN"],
      "note": "不得在沒有合約時記成品牌合作。規則先於任何模型分數。"
    },
    {
      "id": "R2_FRAUD_MIX",
      "when": "入帳話術混合電話、投資或網戀模式，並快速轉出",
      "then": "require_str_or_freeze_or_exit",
      "flags": ["FRAUD_MIX", "R2_IGNORED"],
      "note": "不得把這些入帳改記為品牌合作後結案。"
    }
  ],
  "initial_twin_state": {
    "phase": "periodic_review",
    "customer": {
