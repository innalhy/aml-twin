    {
      "id": "n_outcome_str",
      "type": "outcome",
      "title": "已草擬可疑交易報告",
      "prompt": "上報出口。公司甲與關聯公司乙的合成編號留在狀態裡。",
      "terminal": true,
      "twin_patch": {
        "phase": "closed",
        "disposition": "str_drafted"
      }
    },
    {
      "id": "n_outcome_freeze",
      "type": "outcome",
      "title": "已建議凍結並草擬報告",
      "prompt": "出帳暫停，報告已草擬。品牌合作的記帳覆寫若發生過，旗標仍在。",
      "terminal": true,
