  "nodes": [
    {
      "id": "n_profile",
      "type": "scene",
      "title": "網紅管理公司覆核",
      "prompt": "合成網紅管理公司甲稱經營網紅管理。戶口收到大量個人入帳，沒有品牌合約，也沒有員工薪金紀錄。關聯的合成網紅管理公司乙流水相似。",
      "next": "n_front_gate",
      "twin_patch": {
        "phase": "cdd_review",
        "risk.flags_add": ["FRONT_PROFILE"]
      }
    },
    {
      "id": "n_front_gate",
      "type": "decision",
      "title": "業務說法要不要核",
      "prompt": "合約與薪金都缺。你要做業務加強審查、退出關係，還是先記成品牌合作？",
      "choices": [
        {
          "id": "edd_business",
          "label": "索取管理合約並做加強審查",
          "next": "n_norecords",
          "rationale": "先取業務證據，再讓 R1 判斷。",
          "effects": {
            "kyc.status": "edd_ordered",
            "risk.flags_add": ["EDD_ORDERED"]
          }
        },
        {
          "id": "exit_now",
          "label": "退出客戶關係",
          "next": "n_outcome_exit",
          "rationale": "沒有合約的零售入帳已足夠退出。",
          "effects": {
            "risk.flags_add": ["RELATIONSHIP_EXIT"]
          }
        },
        {
          "id": "book_as_deals",
          "label": "記成品牌合作",
          "next": "n_norecords",
          "rationale": "教學覆寫。沒有合約的事實不會因記帳名稱改變。",
          "effects": {
            "risk.flags_add": ["BOOKED_AS_BRAND"],
            "risk.score_delta": 25
          }
        }
      ]
    },
    {
      "id": "n_norecords",
      "type": "scene",
      "title": "交不出管理合約",
      "prompt": "客戶交不出管理合約。入帳備註像購物、投資、網戀話術，不是品牌合作。規則 R1：這種前台必須加強審查或退出。",
      "next": "n_r1_gate",
      "twin_patch": {
        "kyc.business_evidence": "missing",
        "kyc.status": "evidence_failed",
        "risk.flags_add": ["NO_BUSINESS_RECORD"]
      }
    },
    {
      "id": "n_r1_gate",
      "type": "decision",
      "title": "前台規則的出口",
      "prompt": "R1 已滿足。暫停出帳、現在草擬可疑交易報告，還是接受口頭業務說明？",
      "choices": [
        {
          "id": "hold",
          "label": "暫停出帳並繼續加強審查",
          "next": "n_mix",
          "rationale": "符合 R1。先看會不會快速轉出。",
          "effects": {
            "account.holds": ["outbound"],
            "risk.flags_add": ["EDD_HOLD"]
          }
        },
        {
          "id": "str_now",
          "label": "草擬可疑交易報告",
          "next": "n_outcome_str",
          "rationale": "沒有合約又有零售第三者入帳，可以上報。",
          "effects": {
            "risk.flags_add": ["STR_DRAFTED"]
          }
        },
        {
          "id": "accept_verbal",
          "label": "接受口頭說明並放行",
          "next": "n_mix",
          "rationale": "覆寫 R1。話術類型仍會觸發下一條規則。",
          "effects": {
            "risk.flags_add": ["R1_OVERRIDDEN"],
            "risk.score_delta": 30
          }
        }
      ]
    },
    {
      "id": "n_mix",
      "type": "scene",
      "title": "三類話術並快速轉出",
      "prompt": "進一步對上電話、投資、網戀三類模式，款項快速轉出。規則 R2：不得把這些入帳改記成品牌合作。",
      "next": "n_r2_gate",
      "twin_patch": {
        "phase": "alert_triage",
        "transactions": [
          {
            "id": "TX-KOL-1",
            "kind": "phone_style_in",
            "amount_hkd": 90000
          },
          {
            "id": "TX-KOL-2",
            "kind": "investment_style_in",
            "amount_hkd": 140000
          },
          {
            "id": "TX-KOL-3",
            "kind": "romance_style_in",
            "amount_hkd": 80000
          },
          {
            "id": "TX-KOL-4",
            "kind": "rapid_out",
            "amount_hkd": 290000
          }
        ],
        "risk.flags_add": ["FRAUD_MIX"]
      }
    },
    {
