# TwinAML COMP3424 demo.
# Large media stays out of git. data/media/.gitkeep remains tracked.

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# --- Python / FastAPI ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# --- Node / React (Vite) ---
node_modules/
frontend/dist/
frontend/build/
apps/*/dist/
.npm/
*.tsbuildinfo
.vite/

# --- Logs & local data ---
*.log
logs/
tmp/
temp/
data/local/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# --- Media (keep small fixtures; ignore large binaries) ---
data/media/**
!data/media/.gitkeep
!data/media/**/*.md
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.flac
# To commit a short demo clip later, ignore only the raw originals, for example:
# data/media/raw/

# --- Cloudflare ---
.wrangler/
.dev.vars
.dev.vars.*

# --- Unity ---
# The Editor project lives on branch `unity`. These rules ignore generated
# folders if that tree is checked out into this working copy.
unity/TwinAML/[Ll]ibrary/
unity/TwinAML/[Tt]emp/
unity/TwinAML/[Oo]bj/
unity/TwinAML/[Bb]uild/
unity/TwinAML/[Bb]uilds/
unity/TwinAML/[Ll]ogs/
unity/TwinAML/[Uu]ser[Ss]ettings/
unity/TwinAML/[Mm]emoryCaptures/
unity/TwinAML/[Rr]ecordings/
unity/TwinAML/*.csproj
unity/TwinAML/*.sln
unity/TwinAML/*.suo
unity/TwinAML/*.user
unity/TwinAML/*.userprefs
unity/TwinAML/*.pidb
unity/TwinAML/*.booproj
unity/TwinAML/*.svd
unity/TwinAML/*.pdb
unity/TwinAML/*.mdb
unity/TwinAML/*.opendb
unity/TwinAML/*.VC.db
unity/TwinAML/.vs/

