{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twinaml-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "FRONTEND_ORIGIN": "" },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "InvestigationSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InvestigationSession"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Uncomment and replace the hostname after the zone is on your Cloudflare
  // account. See docs/cloudflare.md. Do not commit account ids or tokens.
  // "routes": [
  //   { "pattern": "api.example.com", "custom_domain": true }
  // ]
}
