# Node reads process environment; load this file with --env-file=.env.
# Clerk Frontend API origin, exactly as the session token's issuer (no trailing slash).
CLERK_ISSUER=
# Clerk Dashboard > API keys. Server only; never put this in a VITE_ variable.
CLERK_SECRET_KEY=
# Optional: PEM JWT public key for offline verification, instead of the secret key.
# Escape line breaks as \n inside a single quoted value, or use a multiline value.
CLERK_JWT_KEY=
# Exact allowed frontend origins, comma-separated. Local Vite origins are built in.
TWINAML_FRONTEND_ORIGIN=
# Keep persistent data outside release directories in production.
# TWINAML_DB=/absolute/path/to/investigation.sqlite
# HOST=127.0.0.1
# PORT=8787
# Explicit anonymous development only: requires NODE_ENV=development and a separate
# database containing no account-owned runs. Leave unset for normal Clerk accounts.
# NODE_ENV=development
# TWINAML_DEV_MODE=1
# TWINAML_DB=/absolute/path/to/development.sqlite
