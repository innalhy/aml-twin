# Optional Neo4j connection. Leave these blank to run Streamlit fully offline
# on the bundled CSV. Do not commit a filled-in .env file.

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required only before a write:
#   python -m twinaml_sandbox.neo4j_link --write
# The loader deletes nodes tagged twinaml-aml-week and leaves other nodes alone.
# The value must match that tag or the write is refused.
NEO4J_SANDBOX_CONFIRM=
